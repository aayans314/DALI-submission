# Supabase: Project Settings -> Database -> Connection string -> "Session pooler"
# (not "Direct connection", which is IPv6-only and Render can't reach it)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Any long random string. Render generates one for you in production.
JWT_SECRET=change-me-to-a-long-random-string

# Where the frontend runs. Comma-separate to allow several.
CLIENT_ORIGIN=http://localhost:5173
